# Postgres connection. Matches the docker-compose "db" service (POSTGRES_DB=encoder).
# Running the app inside the container uses host=db; running it on the host uses host=localhost.
DSN="dbname=encoder sslmode=disable user=postgres password=root host=db"

DSN_TEST=":memory:"

ENV="dev"
DEBUG=true
AUTO_MIGRATE_DB=true

localStoragePath="/tmp"
GOOGLE_APPLICATION_CREDENTIALS="bucket-credentials.json"
VIDEO_SOURCE_BUCKET="joshbarrostest-20260523-1"
VIDEO_OUTPUT_BUCKET="joshbarrostest-20260523-1"

RABBITMQ_URL="amqp://rabbitmq:rabbitmq@rabbit:5672/"
RABBITMQ_QUEUE="video_jobs"
RABBITMQ_CONSUMER="video-encoder-consumer"

CONCURRENCY_WORKERS=1
# Optional: total time budget per job (Go duration, e.g. 45m). Default 30m.
# PROCESS_TIMEOUT="30m"
